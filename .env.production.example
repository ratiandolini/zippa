# ─────────────────────────────────────────────
# საკურიერო პრო — PRODUCTION გარემო
# დააკოპირე .env-ში სერვერზე და შეავსე
# ─────────────────────────────────────────────

NODE_ENV=production

# --- ბაზა (docker-compose.prod.yml ავტომატურად აწყობს DATABASE_URL-ს) ---
POSTGRES_DB=sakuriero
POSTGRES_USER=sakuriero
POSTGRES_PASSWORD=          # ძლიერი პაროლი: openssl rand -base64 24

# --- დომენი და SSL (Caddy) ---
DOMAIN=example.ge
TLS_EMAIL=you@example.ge

# --- აპლიკაცია ---
APP_URL=https://example.ge
AUTH_SECRET=                # openssl rand -base64 32  (მინ. 32 სიმბოლო)
AUTH_COOKIE_NAME=skr_session

# --- პირველი დისპეჩერი (იქმნება პირველ გაშვებაზე, თუ SEED_ON_START=true) ---
SEED_ON_START=true
ADMIN_EMAIL=admin@example.ge
ADMIN_PHONE=+995555000000
ADMIN_PASSWORD=             # შეცვალე პირველი შესვლის შემდეგ
ADMIN_NAME=დისპეჩერი

# --- SMS (smsoffice.ge) — ცარიელი/LOG => არსად აღარ ლოგდება ---
SMS_PROVIDER=LOG            # LOG | SMSOFFICE
SMSOFFICE_KEY=
SMSOFFICE_SENDER=Zippa
# AUTH_DEBUG_RESET_CODES — production-ში არ გამოიყენება (კოდი არასდროს ილოგება)

# --- Cron დაცვა (Vercel Cron ავტომ. აგზავნის Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET=                # openssl rand -base64 24 ; secret-ის გარეშე cron endpoint დაკეტილია

# --- მიტანის ფოტო — Vercel Blob PRIVATE store ---
# Vercel: შექმენი ცალკე Blob Store (access: private) → წაიღე მისი RW token აქ.
# ცარიელი => production-ში ფოტოს ატვირთვა შეჩერდება (public-ზე fallback აკრძალულია).
PROOF_BLOB_READ_WRITE_TOKEN=

# (ძველი — თუ სხვა ფაილებისთვის დაგჭირდა public store)
BLOB_READ_WRITE_TOKEN=

# --- რუკა / გეოკოდირება ---
NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org

# --- გადახდა (მოგვიანებით) ---
PAYMENT_PROVIDER=MOCK
