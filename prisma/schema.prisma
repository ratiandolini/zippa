// საკურიერო პრო — მონაცემთა მოდელი
// PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// მომხმარებლები და როლები
// ─────────────────────────────────────────────

enum Role {
  CUSTOMER
  DRIVER
  DISPATCHER // ადმინი / დისპეჩერი
}

enum AccountType {
  INDIVIDUAL // ფიზიკური პირი
  COMPANY // იურიდიული პირი
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ანგარიშის ტიპი — ფიზიკური / იურიდიული (ინვოისისთვის)
  accountType AccountType @default(INDIVIDUAL)
  companyName String? // იურიდიული დასახელება
  taxId       String? // საიდენტიფიკაციო კოდი / ს/კ

  // საჯარო ოფერტზე თანხმობა
  agreedAt     DateTime?
  termsVersion String?

  // JWT სესიის ვერსია — იზრდება პაროლის ცვლილებაზე, რაც ძველ სესიებს კლავს
  tokenVersion Int @default(0)

  driverProfile    DriverProfile?
  ordersAsCustomer Order[]              @relation("CustomerOrders")
  notifications    Notification[]
  reviewsWritten   Review[]             @relation("ReviewAuthor")
  passwordResets   PasswordReset[]
  codRemittances   CodRemittance[]      @relation("CustomerCodRemittances")
  adjustments      CustomerAdjustment[] @relation("CustomerAdjustments")
  pushSubs         PushSubscription[]

  // პარტნიორი კომპანია — CUSTOMER-ის არჩევითი კომპანიის პროფილი
  companyProfile              CompanyProfile?             @relation("CompanyProfileOwner")
  companyProfilesReviewed     CompanyProfile[]            @relation("CompanyProfileReviewer")
  contractAcceptances         CompanyContractAcceptance[] @relation("ContractAcceptedBy")
  pricingProfilesCreated      CompanyPricingProfile[]     @relation("PricingProfileCreatedBy")
  driverVerificationsReviewed DriverVerification[]        @relation("DriverVerificationReviewer")

  @@index([role])
}

// პაროლის აღდგენა — ტელეფონზე გამოგზავნილი კოდი
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────
// კურიერის პროფილი
// ─────────────────────────────────────────────

enum DriverStatus {
  OFFLINE
  AVAILABLE
  BUSY
}

enum VehicleType {
  BIKE
  MOTORCYCLE
  CAR
  VAN
}

model DriverProfile {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType   VehicleType  @default(MOTORCYCLE)
  vehicleNumber String?
  status        DriverStatus @default(OFFLINE)
  isApproved    Boolean      @default(false) // დისპეჩერი ამტკიცებს ახალ კურიერს

  // მიმდინარე ლოკაცია
  currentLat        Float?
  currentLng        Float?
  locationUpdatedAt DateTime?

  // საბაზისო ქალაქი (სად მუშაობს ძირითადად)
  cityId String?
  city   City?   @relation(fields: [cityId], references: [id])

  ratingAvg       Float @default(5)
  ratingCount     Int   @default(0)
  totalDeliveries Int   @default(0)

  // ფინანსური ბალანსი
  cashOnHand     Decimal @default(0) @db.Decimal(10, 2) // ხელზე აღებული ნაღდი, კომპანიას ჩასაბარებელი
  unpaidEarnings Decimal @default(0) @db.Decimal(10, 2) // დარიცხული, გადაუხდელი ანაზღაურება

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders      Order[]
  earnings    DriverEarning[]
  settlements CashSettlement[]
  payouts     Payout[]

  verification DriverVerification?

  @@index([status])
  @@index([cityId])
}

// ─────────────────────────────────────────────
// გეოგრაფია და ტარიფები
// ─────────────────────────────────────────────

model City {
  id        String   @id @default(cuid())
  name      String   @unique // თბილისი, ქუთაისი, ბათუმი ...
  isActive  Boolean  @default(true)
  centerLat Float
  centerLng Float
  createdAt DateTime @default(now())

  zones   Zone[]
  drivers DriverProfile[]
}

// ზონა ქალაქის შიგნით (მიახლოებით, GeoJSON polygon წერტილების მასივი)
model Zone {
  id        String   @id @default(cuid())
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name      String
  polygon   Json // [[lat,lng], ...]
  createdAt DateTime @default(now())
}

enum DeliveryKind {
  INTRA_CITY // ქალაქის შიგნით
  INTER_CITY // ქალაქებს შორის
}

// მიტანის ზონა (განისაზღვრება მიტანის მისამართით)
enum DeliveryZone {
  TBILISI // თბილისი
  REGIONAL_CITY // რეგიონული ქალაქი (ბათუმი, ქუთაისი, რუსთავი…)
  TOWN_VILLAGE // დაბა / სოფელი
}

// ტარიფის წესი — თითო ზონაზე ერთი. ფასი წონა-კალათებით (ფიქსი, არა კმ-ზე).
model PricingRule {
  id       String       @id @default(cuid())
  zone     DeliveryZone @unique
  isActive Boolean      @default(true)

  // [{ "maxKg": 6, "price": 5 }, { "maxKg": 11, "price": 5 }, ...] — ზრდადი
  weightBrackets Json

  // კურიერის ანაზღაურება წონა-კალათებით: [{ "maxKg": 6, "payout": 2.5 }, ...] — ზრდადი.
  // თუ მითითებულია, თბილისის STANDARD მიტანაზე driverFee აქედან იანგარიშება (არა კმ-ით).
  driverWeightBrackets Json?

  // რეგიონული პარტნიორის ხარჯი თითო ამანათზე (საქ. ფოსტა / რეგიონული კურიერი)
  partnerCost Decimal @default(0) @db.Decimal(10, 2)

  codFee Decimal @default(0) @db.Decimal(10, 2) // ნაღდით გადახდის საკომისიო

  // კურიერის ანაზღაურება ამ ზონის მიტანაზე — ბაზისი + კმ-თარიფი მანძილის ზღვრის მერე
  driverBaseFee Decimal @default(0) @db.Decimal(10, 2) // საბაზისო საფასური თითო მიტანაზე
  driverPerKm   Decimal @default(0) @db.Decimal(10, 2) // კმ-თარიფი driverFreeKm-ის მერე
  driverFreeKm  Decimal @default(0) @db.Decimal(10, 2) // ამ მანძილამდე კმ-თარიფი არ ერიცხება

  // ძველი მოდელი — fallback თუ driverBaseFee = 0
  driverFlatFee       Decimal @default(0) @db.Decimal(10, 2)
  driverPayoutPercent Int? // ალტერნატივა — შემოსავლის %, თუ driverFlatFee = 0

  // მიტანის ვადა
  sameDayCutoffHour Int? // მაგ. 16 → ამ საათამდე გაფორმებული იმ დღესვე მიდის
  deliveryDays      Int  @default(1) // მინიმალური დღეები (0 = იმ დღესვე შესაძლებელია)

  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// შეკვეთა
// ─────────────────────────────────────────────

enum OrderStatus {
  DRAFT
  PENDING // შექმნილია, კურიერი არ ჰყავს
  ASSIGNED // კურიერი მინიჭებულია
  ACCEPTED // კურიერმა მიიღო
  EN_ROUTE_PICKUP // კურიერი გზაშია ასაღებად (მომსახურების ფაქტობრივი დაწყება)
  PICKED_UP // ამანათი აღებულია
  IN_TRANSIT // გზაშია
  DELIVERED // ჩაბარებულია
  CANCELLED
  FAILED // მიტანა ჩაიშალა
}

enum PaymentMethod {
  CASH // ხელზე / ნაღდით (COD)
  CARD // ონლაინ ბარათით
}

enum PaymentStatus {
  UNPAID
  PENDING // ონლაინ გადახდა დაწყებულია
  PAID
  REFUNDED
  FAILED
}

enum PayerSide {
  SENDER
  RECIPIENT
}

// მიტანის დადასტურების ტიპი — რას ითხოვს კურიერისგან ჩაბარებისას
enum DeliveryProof {
  PHOTO // მიტანის ფოტო სავალდებულოა (ნაგულისხმევი)
  PIN // მიმღები ეუბნება კურიერს 4-ნიშნა კოდს
  NONE // დადასტურება არ სჭირდება
}

// მიტანის ჩაშლის მიზეზი (RTO)
enum OrderFailureReason {
  RECIPIENT_UNAVAILABLE // მიმღები ვერ მოიძებნა
  RECIPIENT_REFUSED // მიმღებმა უარი თქვა
  ADDRESS_INVALID // მისამართი არასწორია
  DAMAGED // ამანათი დაზიანდა
  OTHER
}

model Order {
  id             String @id @default(cuid())
  trackingNumber String @unique

  customerId String
  customer   User   @relation("CustomerOrders", fields: [customerId], references: [id])

  driverId String?
  driver   DriverProfile? @relation(fields: [driverId], references: [id])

  status OrderStatus  @default(PENDING)
  kind   DeliveryKind @default(INTRA_CITY)
  zone   DeliveryZone @default(TBILISI)

  // ამგზავნი
  senderName    String
  senderPhone   String
  pickupAddress String
  pickupLat     Float
  pickupLng     Float
  pickupCityId  String?
  pickupNote    String?

  // მიმღები
  recipientName   String
  recipientPhone  String
  deliveryAddress String
  deliveryLat     Float
  deliveryLng     Float
  deliveryCityId  String?
  deliveryNote    String?

  // ამანათი
  weightKg      Decimal  @default(1) @db.Decimal(10, 2)
  description   String?
  parcelValue   Decimal? @db.Decimal(10, 2) // ნივთის ღირებულება — მხოლოდ დაზღვევის/პასუხისმგებლობის ლიმიტისთვის
  collectAmount Decimal  @default(0) @db.Decimal(10, 2) // COD — მიმღებისგან ასაღები თანხა ნივთში (მაღაზიის გაყიდვა)
  codCommission Decimal  @default(0) @db.Decimal(10, 2) // Zippa-ს საკომისიო collectAmount-იდან (სნეპშოტი)

  // COD-ის გამგზავნისთვის გადარიცხვა
  codRemittanceId String?
  codRemittance   CodRemittance? @relation(fields: [codRemittanceId], references: [id])

  // ფასი (გამოთვლილი შექმნისას — სნეპშოტი)
  distanceKm    Decimal @default(0) @db.Decimal(10, 2) // მხოლოდ ინფორმაციული (მარშრუტი/ETA)
  deliveryPrice Decimal @default(0) @db.Decimal(10, 2) // წონა-კალათის ფასი
  codFee        Decimal @default(0) @db.Decimal(10, 2)
  totalPrice    Decimal @default(0) @db.Decimal(10, 2)
  driverFee     Decimal @default(0) @db.Decimal(10, 2) // კურიერს ერგება ამ მიტანაზე (სნეპშოტი)
  partnerCost   Decimal @default(0) @db.Decimal(10, 2) // რეგიონული პარტნიორის ხარჯი (სნეპშოტი)
  companyMargin Decimal @default(0) @db.Decimal(10, 2) // Zippa-ს მარჟა = totalPrice + codCommission − driverFee − partnerCost

  // ფასის წყარო და ხელით შესწორება
  pricingSource         String    @default("RULE") // RULE | MANUAL
  priceAdjustmentReason String?
  priceAdjustedById     String?
  priceAdjustedAt       DateTime?

  // 20 კგ+ ან რთული შემთხვევა — დისპეჩერმა ხელით უნდა დაადასტუროს ფასი, ავტო-მინიჭება იბლოკება
  needsManualReview Boolean @default(false)

  // გადახდა
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(UNPAID)
  payerSide     PayerSide     @default(SENDER)
  codAmount     Decimal       @default(0) @db.Decimal(10, 2) // ნაღდად ასაღები თანხა (მიტანის საფასური ან/და parcelValue)

  // მიტანის დადასტურება
  deliveryProof DeliveryProof @default(PHOTO) // რას ითხოვს კურიერისგან ჩაბარებისას
  deliveryPin   String? // 4-ნიშნა კოდი — მხოლოდ deliveryProof = PIN-ზე
  proofPhotoUrl String?
  signatureUrl  String?
  deliveredAt   DateTime?
  cancelReason  String?
  cancelFee     Decimal       @default(0) @db.Decimal(10, 2) // მომხმარებლის გაუქმების საფასური (კურიერის გზაში-ყოფნისას)

  // მიტანის ჩაშლა (RTO)
  failureReason OrderFailureReason?
  returnFee     Decimal             @default(0) @db.Decimal(10, 2) // გამგზავნს დაბრუნებისთვის დარიცხული

  // გამგზავნის დავალიანება Zippa-სთან (returnFee + cancelFee) — იფარება COD-ის გადარიცხვისას
  chargeSettledAt DateTime?

  // დაბრუნების მოთხოვნა (ამანათის აღების შემდეგ, როცა გაუქმება აღარ შეიძლება)
  returnRequestedAt DateTime?
  returnReason      String?
  returnResolvedAt  DateTime?

  estimatedDeliveryAt DateTime?
  assignedAt          DateTime? // კურიერზე მიბმის დრო (ტაიმაუტისთვის)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events      OrderEvent[]
  payment     Payment?
  review      Review?
  earnings    DriverEarning[]
  adjustments CustomerAdjustment[]

  // მრავალამანათიანი შეკვეთა (additive, Phase 1 — schema + read-only).
  // ძველი (isMultiParcel=false) შეკვეთებზე OrderParcel-row არ იქმნება — ყველა
  // არსებული ველი ზემოთ (weightKg/parcelValue/deliveryPrice/...) ამ შეკვეთებზე
  // ისევ ერთადერთი წყაროა, ისე როგორც აქამდე.
  parcelCount   Int           @default(1)
  isMultiParcel Boolean       @default(false)
  parcels       OrderParcel[] @relation("OrderParcels")

  @@index([status])
  @@index([customerId])
  @@index([driverId])
  @@index([createdAt])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  lat       Float?
  lng       Float?
  actorId   String? // ვინ შეცვალა
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ─────────────────────────────────────────────
// გადახდები (ონლაინ) — პროვაიდერ-აგნოსტიკური
// ─────────────────────────────────────────────

enum PaymentProvider {
  BOG // საქართველოს ბანკი
  TBC // თი-ბი-სი
  MANUAL // ხელით მონიშნული / ნაღდი
}

model Payment {
  id          String          @id @default(cuid())
  orderId     String          @unique
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    PaymentProvider @default(MANUAL)
  providerRef String? // პროვაიდერის ტრანზაქციის ID
  amount      Decimal         @db.Decimal(10, 2)
  currency    String          @default("GEL")
  status      PaymentStatus   @default(PENDING)
  redirectUrl String? // ჰოსტინგ გვერდის URL
  rawPayload  Json?
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// ─────────────────────────────────────────────
// კურიერის ფინანსები
// ─────────────────────────────────────────────

// თითო მიტანილ შეკვეთაზე დარიცხული ანაზღაურება
model DriverEarning {
  id              String        @id @default(cuid())
  driverId        String
  driver          DriverProfile @relation(fields: [driverId], references: [id])
  // ერთ შეკვეთაზე შეიძლება რამდენიმე დარიცხვა: ჩაშლილი მცდელობის კომპენსაცია
  // ერთ კურიერს + ჩაბარება მეორეს (ხელახლა მინიჭების შემდეგ). ამიტომ არა @unique.
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind            String        @default("DELIVERY") // DELIVERY | FAILED_TRIP
  grossPrice      Decimal       @db.Decimal(10, 2) // შეკვეთის სრული ფასი
  driverAmount    Decimal       @db.Decimal(10, 2) // კურიერს ერგება
  companyAmount   Decimal       @db.Decimal(10, 2) // კომპანიის საკომისიო
  collectedInCash Boolean       @default(false) // კურიერმა ნაღდი აიღო?
  isSettled       Boolean       @default(false) // ჩათვლილია payout-ში
  createdAt       DateTime      @default(now())

  @@index([driverId, isSettled])
  @@index([orderId])
}

enum SettlementStatus {
  PENDING // კურიერმა გამოაცხადა, დისპეჩერს არ დაუდასტურებია
  CONFIRMED // დისპეჩერმა მიიღო ნაღდი
  REJECTED // დისპეჩერმა უარყო (თანხა არ ემთხვევა)
}

// ნაღდი ფულის ჩაბარება კურიერისგან კომპანიაში
model CashSettlement {
  id            String           @id @default(cuid())
  driverId      String
  driver        DriverProfile    @relation(fields: [driverId], references: [id])
  amount        Decimal          @db.Decimal(10, 2)
  note          String?
  status        SettlementStatus @default(PENDING)
  confirmedById String? // დისპეჩერი
  confirmedAt   DateTime?
  createdAt     DateTime         @default(now())

  @@index([driverId])
  @@index([status])
}

// დისპეჩერის მიერ მომხმარებლისთვის დარიცხული ანაზღაურება/დაბრუნება
// (მიტანის საფასურის დაბრუნება, ნივთის ანაზღაურება ჩაშლისას, goodwill)
model CustomerAdjustment {
  id          String    @id @default(cuid())
  customerId  String
  customer    User      @relation("CustomerAdjustments", fields: [customerId], references: [id])
  orderId     String?
  order       Order?    @relation(fields: [orderId], references: [id])
  amount      Decimal   @db.Decimal(10, 2) // დადებითი = Zippa უხდის მომხმარებელს
  kind        String // REFUND | COMPENSATION | GOODWILL
  reason      String
  createdById String?
  settledAt   DateTime? // გადაიხადა COD-ის გადარიცხვისას
  createdAt   DateTime  @default(now())

  // მრავალამანათიანი შეკვეთის კონკრეტულ parcel-თან დაკავშირებული adjustment
  // (Phase 4-ის პროპორციული ანაზღაურება) — არჩევითი, ძველ ჩანაწერებზე null.
  parcelId String?
  parcel   OrderParcel? @relation("ParcelAdjustments", fields: [parcelId], references: [id])

  @@index([customerId, settledAt])
}

// COD-ის გადარიცხვა გამგზავნისთვის (შეგროვილი ფული მინუს Zippa-ს საკომისიო)
model CodRemittance {
  id              String   @id @default(cuid())
  customerId      String
  customer        User     @relation("CustomerCodRemittances", fields: [customerId], references: [id])
  grossAmount     Decimal  @db.Decimal(10, 2) // სულ შეგროვილი collectAmount
  commission      Decimal  @db.Decimal(10, 2) // Zippa-ს საკომისიო
  chargesDeducted Decimal  @default(0) @db.Decimal(10, 2) // გამოკლებული დავალიანება (returnFee + cancelFee)
  creditsAdded    Decimal  @default(0) @db.Decimal(10, 2) // დამატებული ანაზღაურება (დისპეჩერის დარიცხვა)
  netAmount       Decimal  @db.Decimal(10, 2) // გამგზავნისთვის (უარყოფითი = გამგზავნი გვმართებს)
  orderCount      Int
  method          String? // "ბანკი" / "ნაღდი"
  note            String?
  createdById     String?
  createdAt       DateTime @default(now())

  orders Order[]

  @@index([customerId])
}

// ანაზღაურების გადახდა კურიერზე
model Payout {
  id          String        @id @default(cuid())
  driverId    String
  driver      DriverProfile @relation(fields: [driverId], references: [id])
  amount      Decimal       @db.Decimal(10, 2)
  periodFrom  DateTime
  periodTo    DateTime
  note        String?
  createdById String?
  createdAt   DateTime      @default(now())

  @@index([driverId])
}

// ─────────────────────────────────────────────
// შეფასება და შეტყობინებები
// ─────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  driverId  String
  rating    Int // 1..5
  comment   String?
  createdAt DateTime @default(now())

  @@index([driverId])
}

enum NotificationType {
  ORDER
  PAYMENT
  SYSTEM
  PROMO
}

// Web Push გამოწერა (ბრაუზერი/მოწყობილობა)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  ua        String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(ORDER)
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

// ─────────────────────────────────────────────
// კონფიგურაცია (key-value)
// ─────────────────────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// განაწილებული rate-limit — საერთო Vercel-ის ყველა serverless ინსტანსისთვის
// (in-memory Map ვერ მუშაობდა მრავალინსტანსიან გარემოში)
model RateLimit {
  key     String   @id // მაგ. "login:1.2.3.4"
  count   Int      @default(1)
  resetAt DateTime // ამ დროის მერე ფანჯარა ნულდება

  @@index([resetAt])
}

// ─────────────────────────────────────────────
// პარტნიორი კომპანია — რეგისტრაცია, ხელშეკრულება, ინდივიდუალური ტარიფები
// (additive — არსებულ CUSTOMER ნაკადს არ ეხება, სანამ არჩევით არ გამოიყენება)
// ─────────────────────────────────────────────

enum CompanyProfileStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

model CompanyProfile {
  id          String @id @default(cuid())
  // ერთი CUSTOMER-ს — მაქსიმუმ ერთი კომპანიის პროფილი (@unique)
  ownerUserId String @unique
  owner       User   @relation("CompanyProfileOwner", fields: [ownerUserId], references: [id])

  legalName         String
  taxId             String
  legalAddress      String
  contactPersonName String
  contactEmail      String
  contactPhone      String
  billingEmail      String?

  status                  CompanyProfileStatus @default(DRAFT)
  rejectionReason         String?
  changesRequestedMessage String?

  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("CompanyProfileReviewer", fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractAcceptances CompanyContractAcceptance[]
  pricingProfiles     CompanyPricingProfile[]
  auditEvents         PartnerAuditEvent[]

  @@index([status])
  @@index([taxId])
}

// ხელშეკრულების ვერსიაზე თანხმობის უცვლელი (append-only) ჩანაწერი.
// ახალი ვერსიის გამოქვეყნება ძველ თანხმობებს არ ცვლის/შლის.
model CompanyContractAcceptance {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  contractVersion     String
  contractTitle       String
  contractContentHash String

  acceptedByUserId  String
  acceptedBy        User     @relation("ContractAcceptedBy", fields: [acceptedByUserId], references: [id])
  acceptedAt        DateTime @default(now())
  // შენახულია მხოლოდ audit/legal მტკიცებულებისთვის (თანხმობის ფაქტის დამადასტურებელი) —
  // იხ. Privacy-ის განახლება ინახვის მიზნისა და ვადის შესახებ.
  acceptedIp        String?
  acceptedUserAgent String?

  createdAt DateTime @default(now())

  @@index([companyProfileId])
}

enum CompanyPricingMode {
  DEFAULT
  DISCOUNT_PERCENT
  CUSTOM_RULES
}

// კომპანიის ინდივიდუალური ტარიფი. მხოლოდ APPROVED კომპანიაზე მოქმედებს (quote/pricing.ts-ში).
// ერთ დროს მაქსიმუმ ერთი აქტიური ჩანაწერი — აპლიკაციის ლოგიკა უზრუნველყოფს ტრანზაქციაში.
model CompanyPricingProfile {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  pricingMode     CompanyPricingMode @default(DEFAULT)
  discountPercent Decimal?           @db.Decimal(5, 2)
  // CUSTOM_RULES: { "TBILISI": [{"maxKg":6,"price":5}, ...], "REGIONAL_CITY": [...], "TOWN_VILLAGE": [...] }
  // — იგივე ფორმა, რაც PricingRule.weightBrackets, ზონების მიხედვით.
  customRules     Json?

  effectiveFrom  DateTime  @default(now())
  effectiveUntil DateTime?
  active         Boolean   @default(false)

  createdById String
  createdBy   User     @relation("PricingProfileCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyProfileId, active])
}

// პარტნიორის განაცხადზე ყველა review-ქმედების (submit/approve/reject/…) აუდიტ ჩანაწერი
model PartnerAuditEvent {
  id               String         @id @default(cuid())
  companyProfileId String
  companyProfile   CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  actorId          String?
  action           String // SUBMITTED | CHANGES_REQUESTED | APPROVED | REJECTED | SUSPENDED | PRICING_UPDATED
  message          String?
  data             Json?
  createdAt        DateTime       @default(now())

  @@index([companyProfileId])
}

// ─────────────────────────────────────────────
// კურიერის დოკუმენტური ვერიფიკაცია
// (additive — რეალურ offer/assign-გატის ჯერ კვლავ DriverProfile.isApproved აკონტროლებს;
// ეს ცხრილები არსებული ლოგიკის ჩამნაცვლებელი არაა, მხოლოდ დისპეჩერის review-ინსტრუმენტი,
// რომლის "დამტკიცება/უარყოფა/შეჩერება" ქმედება წერს DriverProfile.isApproved-ს)
// ─────────────────────────────────────────────

enum TransportType {
  FOOT
  BICYCLE
  MOTORCYCLE
  CAR
  VAN
}

enum DriverVerificationStatus {
  NOT_SUBMITTED
  PENDING
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
}

model DriverVerification {
  id       String        @id @default(cuid())
  driverId String        @unique
  driver   DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  transportType TransportType            @default(FOOT)
  status        DriverVerificationStatus @default(NOT_SUBMITTED)

  // მხოლოდ ბოლო 4 ციფრი — სრული პირადი ნომერი არასდროს ინახება/ჩანს payload-ში
  personalIdLast4 String?

  rejectionReason         String?
  changesRequestedMessage String?

  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("DriverVerificationReviewer", fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents DriverDocument[]

  @@index([status])
}

enum DriverDocumentType {
  ID_FRONT
  ID_BACK
  DRIVER_LICENSE_FRONT
  DRIVER_LICENSE_BACK
  VEHICLE_REGISTRATION
  OTHER
}

enum DriverDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model DriverDocument {
  id                   String             @id @default(cuid())
  driverVerificationId String
  driverVerification   DriverVerification @relation(fields: [driverVerificationId], references: [id], onDelete: Cascade)

  type              DriverDocumentType
  // Vercel Blob PRIVATE store-ის key/url — putProofFile-ის იდენტური ინფრასტრუქტურა.
  // raw URL client-ს/tracking-ს/public API-ს არასდროს გადაეცემა.
  privateStorageKey String
  mimeType          String
  size              Int

  uploadedAt DateTime  @default(now())
  expiresAt  DateTime?

  status       DriverDocumentStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedById String?

  @@index([driverVerificationId])
}

// ─────────────────────────────────────────────
// მრავალამანათიანი შეკვეთა (Phase 1 — additive schema + read-only UI).
// ერთი Order = ერთი dispatcher assignment + ერთი driver; N OrderParcel = თითო
// ამანათის საკუთარი status/failure/return/proof/COD. ძველი (isMultiParcel=false)
// შეკვეთებზე ეს ცხრილები არასდროს გამოიყენება — ისინი Order-ის არსებულ
// ველებზე (weightKg/parcelValue/deliveryPrice/...) ისევ ისე მუშაობენ, როგორც
// აქამდე. NEXT_PUBLIC_MULTI_PARCEL_ORDERS_ENABLED-ის მიღმა (default false)
// შექმნის/სტატუსის ლოგიკა არსად არ არსებობს — Phase 1 მხოლოდ ამის schema-ა.
// ─────────────────────────────────────────────

enum ParcelStatus {
  PENDING
  PICKED_UP
  NOT_PICKED_UP // retryable/intermediate — არა terminal (Phase 3 საკითხავია)
  IN_TRANSIT
  DELIVERED
  REFUSED
  RETURN_REQUESTED
  RETURNED // terminal, მხოლოდ დისპეჩერის გადაწყვეტილებით
  CANCELLED // terminal, მხოლოდ დისპეჩერის გადაწყვეტილებით
  FAILED
}

model OrderParcel {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation("OrderParcels", fields: [orderId], references: [id], onDelete: Cascade)
  sequenceNo Int // 1..N, ჩვენებისთვის ("ამანათი 3/10")

  label         String?
  weightKg      Decimal  @db.Decimal(10, 2)
  description   String?
  // ნივთის დეკლარირებული ღირებულება — არჩევითი (Terms §7.3-ის შესაბამისად).
  // null => ამ ერთ ამანათზე პასუხისმგებლობის ლიმიტია სტანდარტული 100 GEL.
  declaredValue Decimal? @db.Decimal(10, 2)

  status         ParcelStatus @default(PENDING)
  pickupAttempts Int          @default(0)
  pickedUpAt     DateTime?
  deliveredAt    DateTime?

  failureReason     OrderFailureReason?
  failureNote       String?
  returnRequestedAt DateTime?
  returnedAt        DateTime?
  cancelledAt       DateTime?
  proofPhotoUrl     String?

  // COD — თითო ამანათის საკუთარი ასაღები თანხა (Order.collectAmount
  // მრავალამანათიან შეკვეთაზე ხდება ამათი ჯამის rollup, არა წყარო)
  codAmount Decimal @default(0) @db.Decimal(10, 2)

  // Order.deliveryPrice/driverFee-დან წონა-პროპორციულად გამოთვლილი წილი —
  // fix-irdება შექმნისას, არასდროს არ იცვლება უკვე DELIVERED ამანათზე
  // (Phase 4-ის პროპორციული ფინანსური კორექტირების საფუძველი).
  allocatedDeliveryPrice Decimal @default(0) @db.Decimal(10, 2)
  allocatedDriverFee     Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events      OrderParcelEvent[]
  adjustments CustomerAdjustment[] @relation("ParcelAdjustments")

  @@unique([orderId, sequenceNo])
  @@index([orderId])
  @@index([status])
}

// თითო ამანათის სტატუსის ისტორია — OrderEvent-ის ანალოგი, parcel-level
model OrderParcelEvent {
  id        String       @id @default(cuid())
  parcelId  String
  parcel    OrderParcel  @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  status    ParcelStatus
  note      String?
  actorId   String?
  createdAt DateTime     @default(now())

  @@index([parcelId])
}
