# ─────────────────────────────────────────────
# საკურიერო პრო — გარემოს ცვლადები
# დააკოპირე .env-ში და შეავსე რეალური მნიშვნელობებით
# ─────────────────────────────────────────────

# ბაზა (docker-compose-ის ლოკალური Postgres)
DATABASE_URL="postgresql://sakuriero:sakuriero@localhost:5432/sakuriero?schema=public"
# DIRECT_URL — მიგრაციებისთვის. ლოკალურად = DATABASE_URL. Neon-ზე: არა-pooled connection string.
DIRECT_URL="postgresql://sakuriero:sakuriero@localhost:5432/sakuriero?schema=public"

# JWT — მინიმუმ 32 სიმბოლო. გენერაცია: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
AUTH_COOKIE_NAME="skr_session"

# აპლიკაციის საჯარო URL
APP_URL="http://localhost:3000"

# რუკა / მარშრუტიზაცია (უფასო, self-host-ვადი)
NEXT_PUBLIC_NOMINATIM_URL="https://nominatim.openstreetmap.org"
OSRM_URL="https://router.project-osrm.org"

# გადახდა — ჩართე პროდაქშენში (ცარიელი => MANUAL/mock რეჟიმი)
PAYMENT_PROVIDER="MOCK"        # MOCK | BOG | TBC
BOG_CLIENT_ID=""
BOG_CLIENT_SECRET=""
TBC_API_KEY=""
TBC_CLIENT_ID=""

# SMS — ცარიელი/LOG => არსად აღარ ლოგდება (secret-ის დაცვა).
SMS_PROVIDER="LOG"
SMSOFFICE_KEY=""
SMSOFFICE_SENDER="Zippa"

# პაროლის აღდგენის კოდის ლოკალურ კონსოლში ჩვენება — მხოლოდ dev-ში.
# production-ში იგნორირდება. ("true" => LOG-პროვაიდერზე კოდი კონსოლში გამოჩნდება)
AUTH_DEBUG_RESET_CODES=""

# Cron (Vercel Cron ავტომ. აგზავნის) — assignment timeout-ის cron endpoint-ის დასაცავად
CRON_SECRET=""

# მიტანის ფოტო — Vercel Blob PRIVATE store-ის RW token.
# ცარიელი (dev) => ფოტო ინახება public/uploads/. production-ში ცარიელი => ატვირთვა შეჩერდება.
PROOF_BLOB_READ_WRITE_TOKEN=""

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# არჩევითი — default: src/lib/company.ts-ის ელფოსტა
VAPID_SUBJECT=""

# Sentry (შეცდომების მონიტორინგი) — DSN-ის გარეშე გამორთულია
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# source-map ატვირთვისთვის (არასავალდებულო):
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
