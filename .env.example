# ─────────────────────────────────────────────
# საკურიერო პრო — გარემოს ცვლადები
# დააკოპირე .env-ში და შეავსე რეალური მნიშვნელობებით
# ─────────────────────────────────────────────

# ბაზა (docker-compose-ის ლოკალური Postgres)
DATABASE_URL="postgresql://sakuriero:sakuriero@localhost:5432/sakuriero?schema=public"
# DIRECT_URL — მიგრაციებისთვის. ლოკალურად = DATABASE_URL. Neon-ზე: არა-pooled connection string.
DIRECT_URL="postgresql://sakuriero:sakuriero@localhost:5432/sakuriero?schema=public"

# JWT — მინიმუმ 32 სიმბოლო. გენერაცია: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
AUTH_COOKIE_NAME="skr_session"

# აპლიკაციის საჯარო URL
APP_URL="http://localhost:3000"

# რუკა (tiles) + geocoding — Geoapify (უფასო tier).
# geoapify.com → project → API key. ცარიელი => fallback OpenStreetMap Nominatim + OSM tiles.
NEXT_PUBLIC_GEOAPIFY_KEY=""
# (fallback — მხოლოდ თუ Geoapify key არ არის; Nominatim-ის საკუთარი instance)
NOMINATIM_URL=""

# გადახდა — ჩართე პროდაქშენში (ცარიელი => MANUAL/mock რეჟიმი)
PAYMENT_PROVIDER="MOCK"        # MOCK | BOG | TBC
BOG_CLIENT_ID=""
BOG_CLIENT_SECRET=""
TBC_API_KEY=""
TBC_CLIENT_ID=""

# SMS — ცარიელი/LOG => არსად აღარ ლოგდება (secret-ის დაცვა).
SMS_PROVIDER="LOG"
SMSOFFICE_KEY=""
SMSOFFICE_SENDER="Zippa"

# ელფოსტა — ცარიელი/LOG => კონსოლში (production-ში არასდროს ილოგება საიდუმლო შემცველობა)
EMAIL_PROVIDER="LOG"           # LOG | RESEND
RESEND_API_KEY=""
# EMAIL_FROM — მხოლოდ Resend-ში ვერიფიცირებული დომენის მისამართი (Gmail-იდან გაგზავნა არ ხერხდება)
EMAIL_FROM="Zippa <support@zippa.ge>"
# SUPPORT_EMAIL — reply-to + კომპანიის საკონტაქტო ელფოსტა (footer/terms/privacy)
SUPPORT_EMAIL="support.zippa@gmail.com"

# პირველი დისპეჩერი/ადმინი (/api/setup, თუ SEED_ON_START=true)
ADMIN_EMAIL="support.zippa@gmail.com"
ADMIN_PHONE=""
ADMIN_PASSWORD=""
ADMIN_NAME="დისპეჩერი"

# პაროლის აღდგენის კოდის ლოკალურ კონსოლში ჩვენება — მხოლოდ dev-ში.
# production-ში იგნორირდება. ("true" => LOG-პროვაიდერზე კოდი კონსოლში გამოჩნდება)
AUTH_DEBUG_RESET_CODES=""

# Cron (Vercel Cron ავტომ. აგზავნის) — assignment timeout-ის cron endpoint-ის დასაცავად
CRON_SECRET=""

# მიტანის ფოტო — Vercel Blob PRIVATE store-ის RW token.
# ცარიელი (dev) => ფოტო ინახება public/uploads/. production-ში ცარიელი => ატვირთვა შეჩერდება.
PROOF_BLOB_READ_WRITE_TOKEN=""

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# არჩევითი — default: src/lib/company.ts-ის ელფოსტა
VAPID_SUBJECT=""

# Sentry (შეცდომების მონიტორინგი) — DSN-ის გარეშე გამორთულია
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# source-map ატვირთვისთვის (არასავალდებულო):
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ახალი ფუნქციები — default false. production-ში ჩართვამდე სჭირდება Preview QA
# (იხ. docs/OPERATIONS.md). "true"/"false" — string, არა boolean.
NEXT_PUBLIC_PARTNER_ONBOARDING_ENABLED="false"
NEXT_PUBLIC_DRIVER_VERIFICATION_ENABLED="false"

# ჩვეულებრივი (RETAIL) მომხმარებლის +markup — არა NEXT_PUBLIC_ (server-only, ფასის ლოგიკა).
# false => ყველასთვის ზუსტად ის ფასი, რაც ამ ცვლილებამდე იყო. APPROVED პარტნიორი კომპანიაზე
# markup არასდროს ემატება, flag-ის მდგომარეობის მიუხედავად.
RETAIL_PRICE_MARKUP_ENABLED="false"
RETAIL_PRICE_MARKUP_GEL="2"
